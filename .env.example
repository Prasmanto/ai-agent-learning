# Copy this file to `.env` and fill in your real key.
# NEVER commit your real .env file to git. It's in .gitignore.

# ---- Required from lesson 1 onwards ----
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-real-key

# ---- Optional, used in lesson 4 (on-chain) ----
# Any public Ethereum JSON-RPC URL works. Free options that need no signup:
#   https://eth.llamarpc.com
#   https://ethereum.publicnode.com
#   https://rpc.ankr.com/eth
# If you want higher rate limits, sign up at https://alchemy.com and paste your URL.
ETH_RPC_URL=https://eth.llamarpc.com
